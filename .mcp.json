{
  "mcpServers": {
    "zz-template-smoke-debug": {
      "type": "http",
      "url": "http://localhost:4420/debug-mcp"
    },
    "angular": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/angular-mcp"]
    },
    "playwright": {
      "command": "playwright-mcp",
      "args": ["--headless", "--viewport-size", "1280,800", "--output-dir", ".qa/screenshots"]
    }
  }
}
